		h:c:InWinTabBg = rgb_color(136,139,143,255)
		// Inactive Window Tab Text
		h:c:InWinTabTx = rgb_color(255,255,255,255)
		// Window Border
		h:c:WinBr = rgb_color(104,108,113,255)
		// Inactive Window Border
		h:c:InWinBr = rgb_color(136,139,143,255)
		// List Background
		h:c:LstBg = rgb_color(0,0,0,255)
		// List Selected Background
		h:c:LstSBg = rgb_color(100,104,109,255)
		// List Item Text
		h:c:LstTx = rgb_color(255,255,255,255)
		// List Selected Item Text
		h:c:LstSTx = rgb_color(255,255,255,255)
		// Scrollbar Thumb
		h:c:SbThb = rgb_color(86,91,96,255)
		// System Plain
		be:f:be_plain_font = BFont(Noto Sans/Regular/12.00, shear=90.00, rot=0.00, height=12.83+3.52+0.00)
		// System Bold
		be:f:be_bold_font = BFont(Noto Sans/Bold/12.00, shear=90.00, rot=0.00, height=12.83+3.52+0.00)
		// System Fixed
		be:f:be_fixed_font = BFont(Noto Sans Mono/Regular/12.00, shear=90.00, rot=0.00, height=12.83+3.52+0.00)
		// Show Menu Triggers
		be:MenTrig = bool(false)
		// Menu Separator
		be:MenSep = int32(0 or (nil))
		// Menu Item Text
		be:f:MenTx = BFont(Noto Sans/Regular/12.00, shear=90.00, rot=0.00, height=12.83+3.52+0.00)
	}
	// Window decorations and scrollbars
	window_decorations = BMessage(0x00000000) {
		// Window decor
		window:decor = string("Default", 7 bytes)
		// Window decor parameters
		window:decor_globals = BMessage(0x00000000) {
