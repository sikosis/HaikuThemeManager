// new BMessage
BMessage('ZThm') {
	z:theme:infos = BMessage(0x00000000) {
		z:theme:name = string("Dark Mode", 9 bytes)
		z:theme:description = string("Built-in Dark Mode captured from the supplied Haiku settings.", 61 bytes)
		z:theme:keywords = string("Haiku, dark, current settings", 29 bytes)
		z:theme:screenshot = string("screenshot.png", 14 bytes)
	}
	// Desktop backgrounds and color; please respect count and ordering of all fields!
	be:bgndimginfo = BMessage(0x00000000) {
		// If true, use desktop color as icon text background
		be:bgndimginfoerasetext[0] = bool(false)
		be:bgndimginfoerasetext[1] = bool(false)
		be:bgndimginfoerasetext[2] = bool(false)
		be:bgndimginfoerasetext[3] = bool(false)
		be:bgndimginfoerasetext[4] = bool(false)
		be:bgndimginfoerasetext[5] = bool(false)
		be:bgndimginfoerasetext[6] = bool(false)
		be:bgndimginfoerasetext[7] = bool(false)
		be:bgndimginfoerasetext[8] = bool(false)
		// Actual backdrop image file
		be:bgndimginfopath[0] = string("/boot/system/data/artwork/HAIKU logo - white on blue - big.png", 62 bytes)
		be:bgndimginfopath[1] = string("/boot/home/Backgrounds/paris1.png", 33 bytes)
		be:bgndimginfopath[2] = string("/boot/home/Backgrounds/n-himalaya1.png", 38 bytes)
		be:bgndimginfopath[3] = string("/boot/home/Backgrounds/mexico2.png", 34 bytes)
		be:bgndimginfopath[4] = string("/boot/home/Backgrounds/n-himalaya1.png", 38 bytes)
		be:bgndimginfopath[5] = string("/boot/home/Backgrounds/n-crater1.png", 36 bytes)
		be:bgndimginfopath[6] = string("/boot/home/Backgrounds/80sshore1.png", 36 bytes)
		be:bgndimginfopath[7] = string("/boot/home/Backgrounds/himalaya2.png", 36 bytes)
		be:bgndimginfopath[8] = string("/boot/home/Backgrounds/garden2.png", 34 bytes)
		// Workspaces each backdrop apply to
		be:bgndimginfoworkspaces[0] = int32(4294967040 or 0xffffff00)
		be:bgndimginfoworkspaces[1] = int32(1 or 0x1)
		be:bgndimginfoworkspaces[2] = int32(8 or 0x8)
		be:bgndimginfoworkspaces[3] = int32(4 or 0x4)
		be:bgndimginfoworkspaces[4] = int32(2 or 0x2)
		be:bgndimginfoworkspaces[5] = int32(16 or 0x10)
		be:bgndimginfoworkspaces[6] = int32(32 or 0x20)
		be:bgndimginfoworkspaces[7] = int32(64 or 0x40)
		be:bgndimginfoworkspaces[8] = int32(128 or 0x80)
		// Origin point for mode 0
		be:bgndimginfooffset[0] = BPoint(416.0, 548.0)
		be:bgndimginfooffset[1] = BPoint(0.0, 0.0)
		be:bgndimginfooffset[2] = BPoint(0.0, 0.0)
		be:bgndimginfooffset[3] = BPoint(0.0, 0.0)
		be:bgndimginfooffset[4] = BPoint(0.0, 0.0)
		be:bgndimginfooffset[5] = BPoint(416.0, 548.0)
		be:bgndimginfooffset[6] = BPoint(416.0, 548.0)
		be:bgndimginfooffset[7] = BPoint(416.0, 548.0)
		be:bgndimginfooffset[8] = BPoint(416.0, 548.0)
		// image mode: 0=use_origin, 1=centered, 2=scaled, 3=tiled
		be:bgndimginfomode[0] = int32(0 or (nil))
		be:bgndimginfomode[1] = int32(2 or 0x2)
		be:bgndimginfomode[2] = int32(2 or 0x2)
		be:bgndimginfomode[3] = int32(2 or 0x2)
		be:bgndimginfomode[4] = int32(2 or 0x2)
		be:bgndimginfomode[5] = int32(2 or 0x2)
		be:bgndimginfomode[6] = int32(2 or 0x2)
		be:bgndimginfomode[7] = int32(2 or 0x2)
		be:bgndimginfomode[8] = int32(2 or 0x2)
		be:bgndimginfoset[0] = int32(0 or (nil))
		be:bgndimginfoset[1] = int32(0 or (nil))
		be:bgndimginfoset[2] = int32(0 or (nil))
		be:bgndimginfoset[3] = int32(0 or (nil))
		be:bgndimginfoset[4] = int32(0 or (nil))
		be:bgndimginfoset[5] = int32(0 or (nil))
		be:bgndimginfoset[6] = int32(0 or (nil))
		be:bgndimginfoset[7] = int32(0 or (nil))
		be:bgndimginfoset[8] = int32(0 or (nil))
		// one per workspace, up to the last changing one
		be:desktop_color[0] = rgb_color(0,0,0,255)
		be:desktop_color[1] = rgb_color(51,102,152,255)
	}
	// Deskbar position
	deskbar_settings = BMessage(0x00000000) {
		// Deskbar on-screen position
		db:location = int32(3 or 0x3)
